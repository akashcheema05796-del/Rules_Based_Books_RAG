# RAG Benchmark v3 — Environment Variables
# Copy to .env and fill in your values

# OpenAI API key (for text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key (for Claude Sonnet 4.5 — judge, contextual chunking, HyDE)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Global seed for reproducibility
SEED=42

# Cost budget caps (USD) — set to 0 to disable
PHASE1_COST_CAP=10.0
PHASE2_COST_CAP=50.0
PHASE3_COST_CAP=20.0
CONTEXTUAL_CHUNKING_COST_CAP=15.0
